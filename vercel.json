{
  "rewrites": [
    { "source": "/((?!sitemap\\.xml|robots\\.txt|logo\\.webp|favicon\\.svg|assets/).*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.rlbh.org" }],
      "destination": "https://rlbh.org/:path",
      "permanent": true
    }
  ]
}